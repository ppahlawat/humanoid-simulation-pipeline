<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="animated_cube">

  <!-- A fixed base link to attach the joint to -->
  <link name="world"/>

  <!-- The cube that will move -->
  <link name="cube_link">
    <visual>
      <geometry>
        <box size="0.5 0.5 0.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.5 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- The joint that allows the cube to move back and forth -->
  <joint name="slider_joint" type="prismatic">
    <parent link="world"/>
    <child link="cube_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="1 0 0"/> <!-- Move along the X-axis -->
    <limit lower="-3" upper="3" effort="100" velocity="1.0"/>
  </joint>

</robot>
