<?xml version="1.0"?>
  <robot name="humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Properties -->
    <xacro:property name="PI" value="3.1415926535897931" />
    <xacro:property name="DEG_TO_RAD" value="${PI/180}" />
    <xacro:property name="TORSO_HEIGHT" value="0.8" />
    <xacro:property name="TORSO_WIDTH" value="0.3" />
    <xacro:property name="TORSO_LENGTH" value="0.4" />
    <xacro:property name="SHOULDER_SIZE" value="0.4" />
    <xacro:property name="HEAD_RADIUS" value="0.3" />
    <xacro:property name="EYE_RADIUS" value="0.05" />
    <xacro:property name="EYE_POS_X" value="0.08" /> <!-- X-offset from head center -->
    <xacro:property name="EYE_POS_Y" value="${HEAD_RADIUS - 0.01}" /> <!-- Y-offset from head center (slightly protruding) -->
    <xacro:property name="EYE_POS_Z" value="0.05" /> <!-- Z-offset from head center -->


    <!-- Materials -->
    <material name="blue">
      <color rgba="0 0 0.8 1"/>
    </material>
    <material name="red">
      <color rgba="0.8 0 0 1"/>
    </material>
    <material name="green">
      <color rgba="0 0.8 0 1"/>
    </material>
    <material name="white">
      <color rgba="1 1 1 1"/>
    </material>

    <!-- Base Link -->
    <link name="base_link">
      <visual>
        <geometry><box size="0.01 0.01 0.01"/></geometry>
        <material name="green"/>
      </visual>
    </link>

    <!-- TORSO LINK -->
    <joint name="base_to_torso_joint" type="fixed">
      <parent link="base_link"/>
      <child link="torso_link"/>
      <origin xyz="0 0 ${TORSO_HEIGHT/2}" rpy="0 0 0"/>
    </joint>
    <link name="torso_link">
      <visual>
        <geometry><box size="${TORSO_WIDTH} ${TORSO_LENGTH} ${TORSO_HEIGHT}"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><box size="${TORSO_WIDTH} ${TORSO_LENGTH} ${TORSO_HEIGHT}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="20.0"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
      </inertial>
    </link>

    <!-- RIGHT SHOULDER LINK -->
    <joint name="torso_to_right_shoulder_joint" type="fixed">
      <parent link="torso_link"/>
      <child link="right_shoulder_link"/>
      <origin xyz="${TORSO_WIDTH/2 + SHOULDER_SIZE/2 - 0.1} 0 ${TORSO_HEIGHT/2 + SHOULDER_SIZE/2 - 0.4}" rpy="0 0 0"/>
    </joint>
    <link name="right_shoulder_link">
      <visual>
        <geometry><box size="0.2 ${SHOULDER_SIZE} ${SHOULDER_SIZE}"/></geometry>
        <material name="green"/>
      </visual>
      <collision>
        <geometry><box size="0.2 ${SHOULDER_SIZE} ${SHOULDER_SIZE}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- LEFT SHOULDER LINK -->
    <joint name="torso_to_left_shoulder_joint" type="fixed">
      <parent link="torso_link"/>
      <child link="left_shoulder_link"/>
      <origin xyz="-${TORSO_WIDTH/2 + SHOULDER_SIZE/2 - 0.1} 0 ${TORSO_HEIGHT/2 + SHOULDER_SIZE/2 -0.4}" rpy="0 0 0"/>
    </joint>
    <link name="left_shoulder_link">
      <visual>
        <geometry><box size="0.2 ${SHOULDER_SIZE} ${SHOULDER_SIZE}"/></geometry>
        <material name="green"/>
      </visual>
      <collision>
        <geometry><box size="0.2 ${SHOULDER_SIZE} ${SHOULDER_SIZE}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- NECK JOINT (Head rotation) -->
    <joint name="neck_joint" type="revolute">
      <parent link="torso_link"/>
      <child link="head_link"/>
      <origin xyz="0 0 ${TORSO_HEIGHT/2 + HEAD_RADIUS}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-${90 * DEG_TO_RAD}" upper="${90 * DEG_TO_RAD}"
             effort="100" velocity="10"/>
    </joint>

    <!-- HEAD LINK -->
    <link name="head_link">
      <visual>
        <geometry><sphere radius="${HEAD_RADIUS}"/></geometry>
        <material name="red"/>
      </visual>
      <collision>
        <geometry><sphere radius="${HEAD_RADIUS}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="5.0"/>
        <inertia ixx="0.2" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2"/>
      </inertial>
    </link>

    <!-- RIGHT EYE LINK -->
    <joint name="head_to_right_eye_joint" type="fixed">
      <parent link="head_link"/>
      <child link="right_eye_link"/>
      <origin xyz="${EYE_POS_X} ${EYE_POS_Y} ${EYE_POS_Z}" rpy="0 0 0"/>
    </joint>
    <link name="right_eye_link">
      <visual>
        <geometry><sphere radius="${EYE_RADIUS}"/></geometry>
        <material name="white"/>
      </visual>
      <collision>
        <geometry><sphere radius="${EYE_RADIUS}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- LEFT EYE LINK -->
    <joint name="head_to_left_eye_joint" type="fixed">
      <parent link="head_link"/>
      <child link="left_eye_link"/>
      <origin xyz="-${EYE_POS_X} ${EYE_POS_Y} ${EYE_POS_Z}" rpy="0 0 0"/>
    </joint>
    <link name="left_eye_link">
      <visual>
        <geometry><sphere radius="${EYE_RADIUS}"/></geometry>
        <material name="white"/>
      </visual>
      <collision>
        <geometry><sphere radius="${EYE_RADIUS}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

  </robot>
